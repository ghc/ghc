cabal-version:      3.0
name:               eps-hackage
version:            0.1.0.0
synopsis:           Preparation and reporting for the EPS benchmark (system GHC)
build-type:         Simple

executable eps-hackage
  main-is:          Main.hs
  hs-source-dirs:   ., ../common
  other-modules:    EpsHackage.Result
  default-language: GHC2021
  ghc-options:      -Wall
  build-depends:
    , base >=4.18 && <5
    , containers
    , directory
    , filepath
    , process
