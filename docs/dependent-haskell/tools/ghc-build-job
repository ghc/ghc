#!/usr/bin/env bash
# Submit one build to the shared WSL queue.
set -euo pipefail
after=()
if [[ ${1:-} == --after && ${2:-} =~ ^[0-9]+$ ]]; then
    after=(--after "$2")
    shift 2
fi
if (( $# < 2 )) || [[ $1 == --after ]]; then
    echo "Usage: ghc-build-job [--after JOB_ID] LABEL COMMAND [ARG ...]" >&2
    exit 2
fi
label=$1
shift
runtime=/run/user/$(id -u)
mem=${CAPPED_MEM:-16G}
peaks=${HEAVY_PEAKS:-"$HOME/.local/state/heavy/peaks"}
record="$HOME/Code/heavy-management/bin/capped-record"
exec env -u XDG_RUNTIME_DIR pueue add "${after[@]}" --print-task-id --escape --group ghc --label "$label" -- \
    /usr/bin/env "XDG_RUNTIME_DIR=$runtime" "DBUS_SESSION_BUS_ADDRESS=unix:path=$runtime/bus" \
    "CAPPED_LABEL=$label" "CAPPED_MEM=$mem" "HEAVY_PEAKS=$peaks" \
    /usr/bin/systemd-run --user --scope --quiet --slice=ghcbuild.slice \
    --property="MemoryMax=$mem" --property=MemorySwapMax=0 \
    /usr/bin/taskset --cpu-list 0-15 "$record" "$@"
