{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GHC dependencies",
  "description": "The dependency graph of a Haskell program.",
  "oneOf": [
    { "$ref": "#/definitions/home-module" },
    { "$ref": "#/definitions/external-unit" }
  ],
  "definitions": {
    "external-unit": {
      "type": "object",
      "properties": {
        "unit-id": { "$ref": "#/definitions/unit-name" },
        "package-name": { "$ref": "#/definitions/package-name" },
        "package-id": { "$ref": "#/definitions/package-id" }
      },
      "required": ["unit-id", "package-name", "package-id"],
      "unevaluatedProperties": false
    },
    "unit-id": {
      "type": "string"
    },
    "package-name": {
      "type": "string"
    },
    "package-id": {
      "type": "string"
    },
    "module-name": {
      "type": "string"
    },
    "home-module": {
      "type": "object",
      "properties": {
        "module": { "$ref": "#/definitions/module-name" },
        "unit-id": { "$ref": "#/definitions/unit-id" },
        "package-name": { "$ref": "#/definitions/package-name" },
        "source": { "$ref": "#/definitions/home-module-source" },
        "boot": { "type": "boolean" },
        "includes": {
          "type": "array",
          "items": { "$ref": "#/definitions/home-module-include" }
        },
        "imports": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/definitions/import" }
          }
        },
        "preprocessor": { "$ref": "#/definitions/home-module-preprocessor" }
      },
      "required": ["module", "unit-id", "source"],
      "unevaluatedProperties": false
    },
    "home-module-source": {
      "type": "string"
    },
    "home-module-include": {
      "type": "string"
    },
    "home-module-preprocessor": {
      "type": "string"
    },
    "import": {
      "oneOf": [
        { "$ref": "#/definitions/module-name" },
        {
          "type": "object",
          "properties": {
            "module": { "$ref": "#/definitions/module-name" },
            "level": { "$ref": "#/definitions/import-level" },
            "boot": { "type": "boolean" }
          },
          "required": ["module"],
          "unevaluatedProperties": false
        }
      ]
    },
    "import-level": {
      "type": "string",
      "enum": ["normal", "quote", "splice"],
      "default": "normal"
    }
  }
}
