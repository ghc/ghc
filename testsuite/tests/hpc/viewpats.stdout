testCmdLambdaCases: 1
`- exp: 1 "proc n ->\n  (\\cases\n    (id -> 5) (id -> y) -> returnA -< y + 1\n    _ _ -> returnA -< 0) n n"
   +- exp: 2 "id"
   +- exp: 1 "id"
   +- exp: 1 "returnA"
   +- exp: 1 "y + 1"
   |  +- exp: 1 "y"
   |  `- exp: 1 "1"
   +- exp: 1 "returnA"
   +- exp: 1 "0"
   +- exp: 2 "n"
   `- exp: 1 "n"
testCmdLambdaCase: 1
`- exp: 1 "proc n ->\n  (\\case\n    (id -> 5) -> returnA -< 1\n    _ -> returnA -< 0) n"
   +- exp: 2 "id"
   +- exp: 1 "returnA"
   +- exp: 1 "1"
   +- exp: 1 "returnA"
   +- exp: 1 "0"
   `- exp: 2 "n"
testCmdCase: 1
`- exp: 1 "proc n ->\n  case n of\n    (id -> 5) -> returnA -< 1\n    _ -> returnA -< 0"
   +- exp: 2 "n"
   +- exp: 2 "id"
   +- exp: 1 "returnA"
   +- exp: 1 "1"
   +- exp: 1 "returnA"
   `- exp: 1 "0"
testCmdLam: 1
`- exp: 1 "proc n ->\n  (\\(id -> x) -> returnA -< x + 1) n"
   +- exp: 1 "id"
   +- exp: 1 "returnA"
   +- exp: 1 "x + 1"
   |  +- exp: 1 "x"
   |  `- exp: 1 "1"
   `- exp: 1 "n"
exp: 1 "id"
exp: 1 "(5 :: Int)"
testPatBindTopLevel: 1
`- exp: 1 "testTopValue + 1"
   +- exp: 1 "testTopValue"
   `- exp: 1 "1"
testPatBindCmdLet: 1
`- exp: 1 "proc n ->\n  let (id -> x) = n\n  in returnA -< x + 1"
   +- exp: 1 "id"
   +- exp: 1 "n"
   +- exp: 1 "returnA"
   `- exp: 1 "x + 1"
      +- exp: 1 "x"
      `- exp: 1 "1"
testPatBindDo: 1
`- exp: 1 "do\n  let (id -> x) = n\n  pure (x + 1)"
   +- exp: 1 "pure (x + 1)"
   |  `- exp: 1 "(x + 1)"
   |     +- exp: 1 "x"
   |     `- exp: 1 "1"
   `- exp: 1 "let (id -> x) = n"
      +- exp: 1 "id"
      `- exp: 1 "n"
testPatBindGuard: 2
+- exp: 2 "id"
+- exp: 2 "n"
+- GuardBinBox True: 1, GuardBinBox False: 1, exp: 2 "x > 0"
|  +- exp: 2 "x"
|  `- exp: 2 "0"
+- exp-alt: 1 "x + 1"
|  +- exp: 1 "x"
|  `- exp: 1 "1"
+- GuardBinBox True: 1, GuardBinBox False: 0, exp: 1 "otherwise"
`- exp-alt: 1 "0"
testPatBindComp: 1
`- exp: 1 "head [ x + 1\n       | let (id -> x) = n\n       , let (id -> _) = undefined ]"
   `- exp: 1 "[ x + 1\n       | let (id -> x) = n\n       , let (id -> _) = undefined ]"
      +- exp: 1 "id"
      +- exp: 1 "n"
      +- exp: 0 "id"
      +- exp: 0 "undefined"
      `- exp: 1 "x + 1"
         +- exp: 1 "x"
         `- exp: 1 "1"
testPatBindWhere: 1
+- exp: 1 "id"
+- exp: 1 "n"
`- exp: 1 "x + 1"
   +- exp: 1 "x"
   `- exp: 1 "1"
testPatBindLet: 1
`- exp: 1 "let (id -> x) = n\n      (id -> _) = undefined\n  in x + 1"
   +- exp: 0 "id"
   +- exp: 0 "undefined"
   +- exp: 1 "id"
   +- exp: 1 "n"
   +- exp: 1 "x"
   `- exp: 1 "1"
testDoExpansion: 3
`- exp: 3 "do\n  (id -> 5) <- m\n  pure 42"
   +- exp: 1 "pure 42"
   |  `- exp: 1 "42"
   `- exp: 3 "(id -> 5) <- m"
      +- exp: 3 "m"
      `- exp: 2 "id"
testCase: 2
`- exp: 2 "case n of\n  (id -> 5) -> 1\n  _ -> 0"
   +- exp: 2 "n"
   +- exp: 2 "id"
   +- exp-alt: 1 "1"
   `- exp-alt: 1 "0"
testLambdaCases: 1
`- exp: 1 "\\cases\n  (id -> 5) (id -> y) -> y + 1\n  _ _ -> 0"
   +- exp: 2 "id"
   +- exp: 1 "id"
   +- exp-alt: 1 "y + 1"
   |  +- exp: 1 "y"
   |  `- exp: 1 "1"
   `- exp-alt: 1 "0"
testLambdaCase: 1
`- exp: 1 "\\case\n  (id -> 5) -> 1\n  _ -> 0"
   +- exp: 2 "id"
   +- exp-alt: 1 "1"
   `- exp-alt: 1 "0"
testLambda: 1
`- exp: 1 "\\(id -> x) -> x + 1"
   +- exp: 1 "id"
   `- exp: 1 "x + 1"
      +- exp: 1 "x"
      `- exp: 1 "1"
testRec: 1
+- exp: 1 "id"
`- exp: 1 "x + 1"
   +- exp: 1 "x"
   `- exp: 1 "1"
testInfix: 2
+- exp: 1 "id"
+- exp-alt: 1 "x + 1"
|  +- exp: 1 "x"
|  `- exp: 1 "1"
`- exp-alt: 1 "0"
testPrefix: 2
+- exp: 1 "id"
+- exp-alt: 1 "x + 1"
|  +- exp: 1 "x"
|  `- exp: 1 "1"
`- exp-alt: 1 "0"
testQualifiedString: 2
+- exp-alt: 1 "1"
`- exp-alt: 1 "0"
testCoPat: 2
+- exp: 1 "id"
+- exp-alt: 1 "x + 1"
|  +- exp: 1 "x"
|  `- exp: 1 "1"
`- exp-alt: 1 "0"
testNPlusKPat: 2
+- exp-alt: 1 "n * 2"
|  +- exp: 1 "n"
|  `- exp: 1 "2"
`- exp-alt: 1 "0"
testNPat: 2
+- exp-alt: 1 "10"
+- exp-alt: 1 "20"
`- exp-alt: 0 "30"
testSum: 1
+- exp: 1 "id"
+- exp-alt: 1 "x + 1"
|  +- exp: 1 "x"
|  `- exp: 1 "1"
+- exp: 0 "id"
`- exp-alt: 0 "y + 2"
   +- exp: 0 "y"
   `- exp: 0 "2"
testOr: 3
+- exp: 3 "id"
+- exp: 2 "reverse"
+- exp-alt: 2 "True"
`- exp-alt: 1 "False"
testTuple: 1
+- exp: 1 "id"
+- exp: 0 "id"
`- exp: 1 "x + 1"
   +- exp: 1 "x"
   `- exp: 1 "1"
testList: 2
+- exp: 1 "id"
+- exp-alt: 1 "x + 1"
|  +- exp: 1 "x"
|  `- exp: 1 "1"
`- exp-alt: 1 "42"
