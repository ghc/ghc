#!/usr/bin/env bash
set -euo pipefail

# Generate a Cmm source file that is heavy on control flow.
#
# It produces thousands of basic blocks in a single Cmm graph,
# stressing the control-flow handling of the NCG and Wasm backends.
#
# With the default knobs, the procedure looks like this:
#
#          entry
#            |
#            v
#   .---> split0                    \
#   |     /    \                     |
#   |  left0   right0                |  stage 0
#   |     \    /                     |
#   |     join0                     /
#   |       |
#   |       v
#   |    split1 ... join15             stages 1 to 15
#   |       |
#   |       v
#   '---- latch0                       trip0 < 2: back to split0
#           |
#           v
#   .---> split16 ... join31           chunk 1, same shape
#   |       |
#   '---- latch1
#           |
#           v
#          ...
#           |
#           v
#        latch127                      last chunk returns acc
#
# The variables acc and mix stay live through the whole procedure, and
# every branch condition reads mix, so no stage can be folded away.
# The two arms of a diamond swap their constants, so that common block
# elimination cannot merge them.
#
# Each trip counter is set in the entry block and read only at its own
# latch, so all of them start out live and the procedure spills heavily.
#
# Tuning knobs:
#   STAGES       Number of diamond stages to generate. Default: 2048
#   LOOP_PERIOD  Number of stages per loop chunk. Default: 16
#   OUT          Output file. Default: CmmDiamondChain.cmm
#
# Run with STAGES=2 LOOP_PERIOD=2 for a small example of the output.

: "${STAGES:=2048}"
: "${LOOP_PERIOD:=16}"
: "${OUT:=CmmDiamondChain.cmm}"

(( STAGES > 0 && LOOP_PERIOD > 0 )) || {
  echo "STAGES and LOOP_PERIOD must be positive integers" >&2
  exit 1
}

chunk_count=$(( (STAGES + LOOP_PERIOD - 1) / LOOP_PERIOD ))
block_count=$(( 1 + 4 * STAGES + chunk_count ))

emit() {
  printf '%s\n' "$*"
}

{
  emit "// Generated by genCmmDiamondChain"
  emit "//"
  emit "// Parameters:"
  emit "//   STAGES=${STAGES}"
  emit "//   LOOP_PERIOD=${LOOP_PERIOD}"
  emit "//"
  emit "// Cmm blocks: ${block_count}"
  emit "#include \"Cmm.h\""
  emit
  emit "diamond_chain (W_ seed) {"
  emit "  W_ acc;"
  emit "  W_ mix;"
  for ((chunk = 0; chunk < chunk_count; chunk++)); do
    emit "  W_ trip${chunk};"
  done
  emit
  emit "entry:"
  emit "  acc = seed;"
  emit "  mix = seed + (17 :: W_);"
  for ((chunk = 0; chunk < chunk_count; chunk++)); do
    emit "  trip${chunk} = 0;"
  done
  emit "  goto split0;"
  emit

  for ((stage = 0; stage < STAGES; stage++)); do
    next_stage=$(( stage + 1 ))
    chunk=$(( stage / LOOP_PERIOD ))
    k1=$(( 4 * stage + 1 ))
    k2=$(( 4 * stage + 2 ))
    k3=$(( 4 * stage + 3 ))
    k4=$(( 4 * stage + 4 ))

    emit "split${stage}:"
    emit "  mix = mix + (${k1} :: W_);"
    emit "  if (((mix + (${k2} :: W_)) % (7 :: W_)) < (3 :: W_)) {"
    emit "    goto left${stage};"
    emit "  }"
    emit "  goto right${stage};"
    emit

    emit "left${stage}:"
    emit "  acc = acc + (${k3} :: W_);"
    emit "  mix = mix + (${k4} :: W_);"
    emit "  goto join${stage};"
    emit

    emit "right${stage}:"
    emit "  acc = acc + (${k4} :: W_);"
    emit "  mix = mix + (${k3} :: W_);"
    emit "  goto join${stage};"
    emit

    emit "join${stage}:"
    emit "  acc = acc + mix + (${k1} :: W_);"
    if (( next_stage == STAGES || next_stage % LOOP_PERIOD == 0 )); then
      emit "  goto latch${chunk};"
    else
      emit "  goto split${next_stage};"
    fi
    emit
  done

  for ((chunk = 0; chunk < chunk_count; chunk++)); do
    loop_start=$(( chunk * LOOP_PERIOD ))
    next_stage=$(( (chunk + 1) * LOOP_PERIOD ))
    latch_mix=$(( 1000000 + chunk ))
    latch_acc=$(( 2000000 + chunk ))

    emit "latch${chunk}:"
    emit "  trip${chunk} = trip${chunk} + (1 :: W_);"
    emit "  mix = mix + (${latch_mix} :: W_);"
    emit "  acc = acc + (${latch_acc} :: W_);"
    emit "  if (trip${chunk} < (2 :: W_)) {"
    emit "    goto split${loop_start};"
    emit "  }"
    if (( next_stage < STAGES )); then
      emit "  goto split${next_stage};"
    else
      emit "  return (acc);"
    fi
    emit
  done

  emit "}"
} > "$OUT"
