#include "Cmm.h"

// Regression test for the in-place sign-extension in do_mul_may_oflo.
// The local 'a' must remain zero-extended after %mulmayoflo, because it is
// returned to Haskell as a Word.
runMulMayOfloSubword8zh (W_ x, W_ y) {
    I8 a, b, needed;
    a = %lobits8(x);
    b = %lobits8(y);
    needed = %mulmayoflo(a, b);
    if (needed != 0::I8) {
        return (0);
    } else {
        return (%zx64(a));
    }
}

