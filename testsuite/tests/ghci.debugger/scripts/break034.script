:l break034
:set -fbreak-on-error
:set -fno-break-on-exception
:break f
f 1
-- Killing the thread stopped at the breakpoint may break again, on the
-- ThreadKilled exception; :abandon must still clean up without errors and
-- without blocking there.
:abandon
f 2
:abandon
-- A few more variations
:set -fno-break-on-error
:set -fbreak-on-exception
f 3
:abandon
:set -fbreak-on-error
:set -fbreak-on-exception
f 4
:abandon
putStrLn "done"
