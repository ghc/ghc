****************************************
Input:
    let s = "world" :: Text; x = True in s <> s" hello ${s} ${x}" :: Text
====>
    "world hello world True"
****************************************
Input:
    let s = "world" :: Text; x = True in
      s"""
      hello
      ${s}
      ${x}
      """
====>
    "hello\nworld\nTrue"
