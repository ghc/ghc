
==================== Tidy Core ====================
Result size of Tidy Core
  = {terms: 127, types: 130, coercions: 24, joins: 0/0}

$dmop
  = \ @a $dC $dOrd xs ys ->
      case $fOrdList_$ccompare $dOrd xs ys of {
        __DEFAULT ->
          (reverse1 (reverse1 (reverse1 (reverse1 (++ xs ys) []) []) []) [])
          `cast` <Co:3>;
        GT ->
          (reverse1 (reverse1 (reverse1 (reverse xs) []) []) [])
          `cast` <Co:3>
      }

$fCInt_$cop
  = \ xs ys ->
      case $fOrdList_$s$ccompare xs ys of {
        __DEFAULT ->
          (reverse1 (reverse1 (reverse1 (reverse1 (++ xs ys) []) []) []) [])
          `cast` <Co:3>;
        GT ->
          (reverse1 (reverse1 (reverse1 (reverse xs) []) []) [])
          `cast` <Co:3>
      }

$fCInt1
  = \ xs ys ->
      case $fOrdList_$s$ccompare xs ys of {
        __DEFAULT ->
          (reverse1 (reverse1 (reverse1 (reverse1 (++ xs ys) []) []) []) [])
          `cast` <Co:3>;
        GT ->
          (reverse1 (reverse1 (reverse1 (reverse xs) []) []) [])
          `cast` <Co:3>
      }

$fCInt = C:C $fCInt1

test4 = reverse1 [] []

test3 = reverse1 test4 []

test2 = reverse1 test3 []

test1 = reverse1 test2 []

test
  = \ xs ->
      case $fOrdList_$s$ccompare [] xs of {
        __DEFAULT ->
          (reverse1 (reverse1 (reverse1 (reverse1 (++ [] xs) []) []) []) [])
          `cast` <Co:3>;
        GT -> test1 `cast` <Co:3>
      }



