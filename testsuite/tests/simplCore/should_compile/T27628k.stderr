    SpecConstr specialised ‘go :: T -> Int -> Int’
      source:       T27628k.hs:17:1
      recursivity:  self-recursive
      call patterns:
        go (A _) (I# _)
          -- reboxes ‘A’
          --      as ‘$sgo :: Int -> GHC.Internal.Prim.Int# -> Int’
        go (B _) (I# _)
          -- reboxes ‘B’
