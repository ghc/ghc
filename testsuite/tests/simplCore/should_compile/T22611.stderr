"alterF/Identity"
    forall @k @a $dFunctor $dOrd k1 f.
      alterF $dFunctor $dOrd f k1
      = (\ t -> alter $dOrd (f `cast` <Co:7>) k1 t) `cast` <Co:10>
"alterF/Const"
    forall @k @a @b $dFunctor $dOrd k1 f.
      alterF $dFunctor $dOrd f k1
      = (\ m -> f (lookup $dOrd k1 m)) `cast` <Co:18>


