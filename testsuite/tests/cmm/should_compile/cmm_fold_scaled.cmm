#include "Cmm.h"

// GHC.Cmm.Opt's folding must take the constant out of an added shift or
// product of a sum: p + ((i + 1) << 3) becomes (p + (i << 3)) + 8, one x86
// address, and q + (i + 2) * 24 becomes (q + i * 24) + 48.  It must leave
// (1 - i) << 3, a subtracted index once folded, and (i + 1) << 40, whose
// constant is wider than 32 bits, as they are.

shladd (W_ p, W_ i)
{
    W_ z;
    z = (i + 1) << 3;
    return (I64[p + z]);
}

muladd (W_ q, W_ i)
{
    W_ z;
    z = (i + 2) * 24;
    return (q + z);
}

subidx (W_ p, W_ i)
{
    W_ z;
    z = (1 - i) << 3;
    return (I64[p + z]);
}

wide (W_ q, W_ i)
{
    W_ z;
    z = (i + 1) << 40;
    return (q + z);
}
