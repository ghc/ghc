#include "Cmm.h"

// Each procedure accesses memory at q + k, a CmmRegOff once folded;
// cmm_regoff.hs passes q = p - k, so that the address is p.

rl01 (W_ q) {
    return (I64[q + 8]);
}

rn01 (W_ q) {
    return (%sx64(I8[q + 8]) + %zx64(I16[q + 8]) + %sx64(I32[q + 8]));
}

rs01 (W_ q, W_ v) {
    I64[q + 8] = v;
    I8[q + 8] = %lobits8(v >> 8);
    return (I64[q + 8]);
}

rl02 (W_ q) {
    return (I64[q - 8]);
}

rn02 (W_ q) {
    return (%sx64(I8[q - 8]) + %zx64(I16[q - 8]) + %sx64(I32[q - 8]));
}

rs02 (W_ q, W_ v) {
    I64[q - 8] = v;
    I8[q - 8] = %lobits8(v >> 8);
    return (I64[q - 8]);
}

