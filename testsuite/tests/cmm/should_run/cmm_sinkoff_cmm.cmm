#include "Cmm.h"

// Each procedure sinks a, a sum or difference with a constant, into
// b = a + k2 or b = a - k2, which constant folding makes a register offset
// of a; cmm_sinkoff.hs computes the same formula in Haskell.

s1_64_c1 (W_ xw, W_ yw) {
    bits64 x, y, a, b; x = %lobits64(xw); y = %lobits64(yw);
    a = (x ^ y) - (1::bits64);
    b = a + (1::bits64);
    return (%zx64(b));
}

s1_64_c2 (W_ xw, W_ yw) {
    bits64 x, y, a, b; x = %lobits64(xw); y = %lobits64(yw);
    a = (x ^ y) - (9223372036854775807::bits64);
    b = a + (1::bits64);
    return (%zx64(b));
}

s1_64_c3 (W_ xw, W_ yw) {
    bits64 x, y, a, b; x = %lobits64(xw); y = %lobits64(yw);
