#include "Cmm.h"

// Each procedure but ta, which returns lbl, loads or stores at (i << s) + lbl,
// or computes (x << s) + k, with no base; cmm_scaledlit.hs compares it with the
// same formula computed in Haskell.

section "data" {
    cmm_scaledlit_tbl: bits64 72623859790382856; bits64 145247719580765712; bits64 217871579371148568; bits64 290495439161531424; bits64 363119298951914280; bits64 435743158742297136; bits64 508367018532679992; bits64 580990878323062848; bits64 653614738113445704; bits64 726238597903828560; bits64 798862457694211416; bits64 871486317484594272; bits64 944110177274977128; bits64 1016734037065359984; bits64 1089357896855742840; bits64 1161981756646125696;
}

section "data" {
    cmm_scaledlit_rw: bits64 0; bits64 0; bits64 0; bits64 0; bits64 0; bits64 0; bits64 0; bits64 0; bits64 0; bits64 0; bits64 0; bits64 0; bits64 0; bits64 0; bits64 0; bits64 0;
}

t64 (W_ i) {
    return (I64[(i << 3) + cmm_scaledlit_tbl]);
}

t64p (W_ i) {
    return (I64[(i << 3) + (cmm_scaledlit_tbl + 8)]);
}

t64m (W_ i) {
    return (I64[(i << 3) + (cmm_scaledlit_tbl - 8)]);
}

t32 (W_ i) {
    return (%zx64(I32[(i << 2) + cmm_scaledlit_tbl]));
}

t16 (W_ i) {
    return (%zx64(I16[(i << 1) + cmm_scaledlit_tbl]));
}

t8 (W_ i) {
    return (%zx64(I8[(i << 0) + cmm_scaledlit_tbl]));
}

t32b (W_ i) {
    return (%zx64(I32[(i << 3) + (cmm_scaledlit_tbl + 4)]));
}

ts64 (W_ i, W_ v) {
    I64[(i << 3) + cmm_scaledlit_rw] = v;
    return (I64[(i << 3) + cmm_scaledlit_rw]);
}

ts32 (W_ i, W_ v) {
    I32[(i << 2) + (cmm_scaledlit_rw + 4)] = %lobits32(v);
    return (%zx64(I32[(i << 2) + (cmm_scaledlit_rw + 4)]));
}

tl (W_ i) {
    return ((i << 3) + cmm_scaledlit_tbl);
}

ta (W_ i) {
    return (cmm_scaledlit_tbl);
}

